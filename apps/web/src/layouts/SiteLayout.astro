---
import '../styles/site.css';
import frastoLogo from '../../../../logo/frastro_logo.svg';
import ProjectFooter from '../components/ProjectFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  robots?: string;
}

const { title, description, robots } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" type="image/svg+xml" href={frastoLogo.src} />
    <script is:inline>
      let savedTheme = null;
      try {
        const currentTheme = localStorage.getItem('starlight-theme');
        const legacyTheme = localStorage.getItem('frasto-site-theme');
        savedTheme = currentTheme === 'light' || currentTheme === 'dark'
          ? currentTheme
          : legacyTheme === 'light' || legacyTheme === 'dark'
            ? legacyTheme
            : null;
        if (!currentTheme && savedTheme) localStorage.setItem('starlight-theme', savedTheme);
      } catch {}
      const systemTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const theme = savedTheme ?? systemTheme;
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
    </script>
    <title>{title}</title>
  </head>
  <body data-frasto-root>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <ProjectFooter />
  </body>
</html>
