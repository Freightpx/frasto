---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Brand from '../../components/Brand.astro';
import { Avatar, Breadcrumb, BreadcrumbItem, Button, Checkbox, Dialog, Drawer, Dropdown, DropdownItem, EmptyState, FileTextIcon, FormDescription, FormField, FormLabel, Icon, IconButton, Input, MenuIcon, PageHeader, PlusIcon, Popover, Radio, SearchInput, Select, Separator, Skeleton, Spinner, Status, Surface, Switch, Tab, Table, TabPanel, Tabs, Textarea, Tooltip } from '@freight-px/frasto';
import avatar01 from '../../../../../avatars/frasto_avatar-01.svg';
import avatar02 from '../../../../../avatars/frasto_avatar-02.svg';
import avatar03 from '../../../../../avatars/frasto_avatar-03.svg';
---

<SiteLayout
  title="Demo — Frasto UI"
  description="A working preview of Frasto's application design direction."
>
  <section class="demo-intro">
    <p class="index-label">03 / DEMO</p>
    <h1>Application preview</h1>
    <p>The customer workspace will become Frasto’s first complete component reference.</p>
  </section>

  <Surface as="section" class="demo-frame" variant="outlined" padding="none" aria-label="Customer workspace preview">
    <aside class="demo-sidebar">
      <Brand class="demo-brand" size="sm" suffix="DEMO" />
      <nav aria-label="Demo navigation">
        <a href="#">Overview</a>
        <a class="is-active" href="#" aria-current="page">Customers</a>
        <a href="#">Orders</a>
        <a href="#">Settings</a>
      </nav>
    </aside>
    <div class="demo-workspace">
      <PageHeader title="Customers" description="Manage customer records and account status." headingLevel={2}>
        <Breadcrumb slot="breadcrumb" label="Customer workspace">
          <BreadcrumbItem href="#">Workspace</BreadcrumbItem>
          <BreadcrumbItem current>Customers</BreadcrumbItem>
        </Breadcrumb>
        <span slot="metadata">128 customer records · Updated today</span>
        <Dropdown slot="actions" label="Customer actions">
          <Tooltip slot="trigger" content="More customer actions" placement="bottom">
            <IconButton icon={MenuIcon} label="Open customer actions" variant="outline" />
          </Tooltip>
          <DropdownItem>Export customer list</DropdownItem>
          <DropdownItem>Import customers</DropdownItem>
          <DropdownItem disabled>Archive selected</DropdownItem>
        </Dropdown>
        <Dialog slot="actions" title="Add customer" description="Create a customer record for the account workspace.">
          <Button slot="trigger"><Icon icon={PlusIcon} slot="icon-start" /> Add customer</Button>
          <form class="demo-overlay-form">
            <FormField>
              <FormLabel for="new-customer-name" required>Customer name</FormLabel>
              <Input id="new-customer-name" name="name" autocomplete="name" required />
            </FormField>
            <FormField>
              <FormLabel for="new-customer-status">Initial status</FormLabel>
              <Select id="new-customer-status" name="status">
                <option value="active">Active</option>
                <option value="invited">Invited</option>
                <option value="inactive">Inactive</option>
              </Select>
            </FormField>
          </form>
          <Button slot="footer" variant="outline" data-frasto-dialog-close>Cancel</Button>
          <Button slot="footer" type="button">Create customer</Button>
        </Dialog>
      </PageHeader>
      <Tabs class="demo-tabs" label="Customer sections" defaultValue="overview">
        <Tab slot="tab" value="overview">Overview</Tab>
        <Tab slot="tab" value="invoices">Invoices</Tab>
        <TabPanel slot="panel" value="overview" class="demo-tab-panel">
          <div class="demo-toolbar">
            <form class="demo-search" action="/demo/" method="get" role="search">
              <SearchInput id="customer-search" name="query" label="Search customers" placeholder="Search customers…" />
            </form>
            <Popover label="Customer refresh status" placement="bottom-end">
              <Button slot="trigger" size="sm" variant="ghost"><Spinner size="sm" slot="icon-start" /> Refreshing 128 records</Button>
              <p class="demo-popover-label">LIVE DATA</p>
              <strong>Customer list refresh</strong>
              <p class="demo-popover-copy">Three records are current. The next result is still loading.</p>
            </Popover>
          </div>
          <Table caption="Customers" captionHidden minWidth="42rem">
              <thead><tr><th scope="col">Customer</th><th scope="col">Company</th><th scope="col">Status</th><th scope="col">Updated</th></tr></thead>
              <tbody>
                <tr>
                  <td>
                    <Drawer title="Maya Chen" description="Customer account context" size="sm">
                      <button class="demo-customer-trigger" slot="trigger" type="button">
                        <Avatar size="sm" src={avatar01} alt="" imageClass="frasto-avatar-artwork" /><span>Maya Chen</span>
                      </button>
                      <dl class="demo-detail-list">
                        <div><dt>Company</dt><dd>Northstar Goods</dd></div>
                        <div><dt>Status</dt><dd><Status tone="positive">Active</Status></dd></div>
                        <div><dt>Owner</dt><dd>Commercial team</dd></div>
                        <div><dt>Last updated</dt><dd>Today</dd></div>
                      </dl>
                    </Drawer>
                  </td>
                  <td>Northstar Goods</td><td><Status tone="positive">Active</Status></td><td>Today</td>
                </tr>
                <tr><td><span class="demo-customer"><Avatar size="sm" src={avatar02} alt="" imageClass="frasto-avatar-artwork" /><span>Arman Yusuf</span></span></td><td>Common Supply</td><td><Status tone="positive">Active</Status></td><td>Yesterday</td></tr>
                <tr><td><span class="demo-customer"><Avatar size="sm" src={avatar03} alt="" imageClass="frasto-avatar-artwork" /><span>Elena Rossi</span></span></td><td>Studio Porto</td><td><Status marker={false}>Invited</Status></td><td>24 Aug</td></tr>
                <tr class="demo-loading-row" aria-busy="true">
                  <td>
                    <span class="sr-only">Loading another customer</span>
                    <span class="demo-customer"><Skeleton class="demo-avatar-skeleton" variant="block" /><Skeleton style="width:7rem;" /></span>
                  </td>
                  <td><Skeleton style="width:8rem;" /></td>
                  <td><Skeleton style="width:4rem;" /></td>
                  <td><Skeleton style="width:3.5rem;" /></td>
                </tr>
              </tbody>
          </Table>
          <Separator class="demo-section-separator" />
          <section class="demo-editor" aria-labelledby="customer-note-title">
            <div>
              <p class="index-label">02 / CUSTOMER NOTE</p>
              <h3 id="customer-note-title">Keep account context close.</h3>
              <p>Add an internal note for the team handling this customer.</p>
            </div>
            <form class="demo-editor-form">
              <FormField>
                <FormLabel for="customer-note">Internal note</FormLabel>
                <FormDescription id="customer-note-help">Visible to teammates with customer access.</FormDescription>
                <Textarea id="customer-note" name="note" placeholder="Add operational context…" aria-describedby="customer-note-help" />
              </FormField>
              <FormField>
                <FormLabel for="note-priority">Priority</FormLabel>
                <Select id="note-priority" name="priority">
                  <option value="normal">Normal</option>
                  <option value="follow-up">Follow up</option>
                  <option value="urgent">Urgent</option>
                </Select>
              </FormField>
              <fieldset class="demo-choice-group">
                <legend>Visibility</legend>
                <Radio name="visibility" value="team" checked>Team only</Radio>
                <Radio name="visibility" value="shared">Shared with customer</Radio>
              </fieldset>
              <Checkbox name="notify-owner" checked>Notify the account owner about this update</Checkbox>
              <Switch name="pin-note" checked>Pin new notes to the customer timeline</Switch>
              <div class="demo-form-actions">
                <Button type="button" size="sm">Save note</Button>
              </div>
            </form>
          </section>
        </TabPanel>
        <TabPanel slot="panel" value="invoices" class="demo-tab-panel">
          <EmptyState
            title="No invoices yet"
            description="Invoices will appear here after the first billing cycle. You can also create one manually."
            headingLevel={3}
          >
            <Icon slot="icon" icon={FileTextIcon} size={20} />
            <Button slot="actions" size="sm"><Icon icon={PlusIcon} slot="icon-start" /> Create invoice</Button>
            <Button slot="actions" size="sm" variant="ghost">View billing guide</Button>
            <span slot="footer">Billing access is managed by workspace administrators.</span>
          </EmptyState>
        </TabPanel>
      </Tabs>
    </div>
  </Surface>
</SiteLayout>
