---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomepageShowcase from '../components/HomepageShowcase.astro';
import astroMarkInk from '../assets/astro-mark-ink.svg';
import astroMarkGradient from '../assets/astro-mark-gradient.svg';
import { ArrowUpRightIcon, Button, Icon } from '@freight-px/frasto';
---

<SiteLayout
  title="Frasto UI — Astro UI components built for consistency"
  description="An Astro-first open-source UI component library and design system for modern interfaces and applications."
>
  <section class="hero-shell">
    <div class="hero-background" aria-hidden="true"></div>
    <div class="hero-grid">
      <div>
        <h1>
          <span class="hero-astro-line">
            <span class="hero-astro-mark" aria-hidden="true">
              <img class="hero-astro-mark__logo hero-astro-mark__logo--light" src={astroMarkInk.src} alt="" width="80" height="100" />
              <img class="hero-astro-mark__logo hero-astro-mark__logo--dark" src={astroMarkGradient.src} alt="" width="80" height="100" />
            </span>
            <span>Astro UI components.</span>
          </span>
          <span>Built for consistency.</span>
        </h1>
      </div>
      <div class="hero-copy">
        <p class="alpha-label">PUBLIC ALPHA · 0.1.0-alpha.1</p>
        <p>
          An open-source component library and design system for modern websites,
          applications, dashboards, portals, and content-driven products.
        </p>
        <div class="hero-actions">
          <Button href="/docs/getting-started/introduction/">Read the docs <Icon icon={ArrowUpRightIcon} slot="icon-end" /></Button>
          <Button href="#components" variant="outline">Browse components <Icon icon={ArrowUpRightIcon} slot="icon-end" /></Button>
        </div>
        <div class="install-command" aria-label="Install the Frasto public alpha">
          <code>pnpm add @freight-px/frasto@next</code>
        </div>
        <p class="hero-links">
          <a href="https://www.npmjs.com/package/@freight-px/frasto">npm package</a>
          <span aria-hidden="true">/</span>
          <a href="https://github.com/Freightpx/frasto">GitHub repository</a>
        </p>
      </div>
    </div>
  </section>
  <HomepageShowcase />
</SiteLayout>
