---
import SiteLayout from '../layouts/SiteLayout.astro';
import { ArrowUpRightIcon, Button, Icon } from '@freightpx/frasto';
---

<SiteLayout
  title="Frasto UI — Astro-first component library"
  description="An Astro-first open-source UI component library and design system for modern interfaces and applications."
>
  <section class="hero-shell">
    <p class="index-label">01 / ASTRO-FIRST UI</p>
    <div class="hero-grid">
      <div>
        <h1>Astro-first UI.<br />Quiet confidence.</h1>
      </div>
      <div class="hero-copy">
        <p class="alpha-label">PUBLIC ALPHA · 0.1.0-alpha.1</p>
        <p>
          An open-source component library and design system for modern websites,
          applications, dashboards, portals, and content-driven products.
        </p>
        <div class="hero-actions">
          <Button href="/docs/getting-started/introduction/">Read the docs <Icon icon={ArrowUpRightIcon} slot="icon-end" /></Button>
          <Button href="/demo/" variant="outline">View the demo <Icon icon={ArrowUpRightIcon} slot="icon-end" /></Button>
        </div>
        <div class="install-command" aria-label="Install the Frasto public alpha">
          <code>pnpm add @freightpx/frasto@next</code>
        </div>
        <p class="hero-links">
          <a href="https://www.npmjs.com/package/@freightpx/frasto">npm package</a>
          <span aria-hidden="true">/</span>
          <a href="https://github.com/Freightpx/frasto">GitHub repository</a>
        </p>
      </div>
    </div>
  </section>

  <section class="principles" aria-labelledby="principles-heading">
    <div class="section-heading">
      <p class="index-label">02 / FOUNDATION</p>
      <h2 id="principles-heading">Built for real interface work.</h2>
    </div>
    <ol class="principle-list">
      <li><span>01</span><strong>Server first</strong><p>Useful HTML before JavaScript.</p></li>
      <li><span>02</span><strong>Open-source first</strong><p>Useful on its own, without artificial limits.</p></li>
      <li><span>03</span><strong>Broad coverage</strong><p>Reusable components for websites and applications.</p></li>
      <li><span>04</span><strong>Accessible states</strong><p>Every state is part of the component contract.</p></li>
    </ol>
  </section>
</SiteLayout>
