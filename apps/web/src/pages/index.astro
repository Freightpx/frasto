---
import SiteLayout from '../layouts/SiteLayout.astro';
import { ArrowUpRightIcon, Button, Icon } from '@freightpx/frasto';
---

<SiteLayout
  title="Frasto UI — Application components for Astro"
  description="An Astro-first design system for serious SaaS applications."
>
  <section class="hero-shell">
    <p class="index-label">01 / ASTRO-FIRST UI</p>
    <div class="hero-grid">
      <div>
        <h1>Serious interfaces.<br />Quiet confidence.</h1>
      </div>
      <div class="hero-copy">
        <p>
          A server-first component system for dashboards, CRM, CMS, ERP, and the
          operational software people use every day.
        </p>
        <div class="hero-actions">
          <Button href="/docs/getting-started/introduction/">Read the docs <Icon icon={ArrowUpRightIcon} slot="icon-end" /></Button>
          <Button href="/demo/" variant="outline">View the demo <Icon icon={ArrowUpRightIcon} slot="icon-end" /></Button>
        </div>
      </div>
    </div>
  </section>

  <section class="principles" aria-labelledby="principles-heading">
    <div class="section-heading">
      <p class="index-label">02 / FOUNDATION</p>
      <h2 id="principles-heading">Built for application work.</h2>
    </div>
    <ol class="principle-list">
      <li><span>01</span><strong>Server first</strong><p>Useful HTML before JavaScript.</p></li>
      <li><span>02</span><strong>Operational density</strong><p>Compact without becoming cramped.</p></li>
      <li><span>03</span><strong>Backend agnostic</strong><p>Your data and application architecture stay yours.</p></li>
      <li><span>04</span><strong>Accessible states</strong><p>Every state is part of the component contract.</p></li>
    </ol>
  </section>
</SiteLayout>
