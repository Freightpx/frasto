---
import { ThemeSwitch } from '@freight-px/frasto';

interface Props {
  label?: string;
}

const { label = 'Primary navigation' } = Astro.props;
const pathname = Astro.url.pathname;
const isComponents = pathname.startsWith('/docs/components/') || pathname.startsWith('/docs/application-components/');
const isDocs = pathname.startsWith('/docs/') && !isComponents;
---

<nav class="site-navigation" aria-label={label}>
  <div class="site-navigation__primary">
    <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</a>
    <a href="/docs/" aria-current={isDocs ? 'page' : undefined}>Documentation</a>
    <a href="/docs/components/overview/" aria-current={isComponents ? 'page' : undefined}>Components</a>
  </div>
  <div class="site-navigation__external">
    <a href="https://github.com/Freightpx/frasto">GitHub</a>
    <a class="site-navigation__npm" href="https://www.npmjs.com/package/@freight-px/frasto">npm</a>
  </div>
  <ThemeSwitch
    variant="animated-icon"
    storageKey="starlight-theme"
    label="Site color theme"
  />
</nav>

<style>
  .site-navigation,
  .site-navigation__primary,
  .site-navigation__external {
    display: flex;
    align-items: center;
  }

  .site-navigation {
    min-width: 0;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    font-size: 0.8125rem;
  }

  .site-navigation__primary,
  .site-navigation__external {
    gap: clamp(0.75rem, 1.7vw, 1.25rem);
  }

  a {
    position: relative;
    padding-block: 0.35rem;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  a::after {
    content: '';
    position: absolute;
    inset: auto 0 -0.4rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
  }

  a:hover::after,
  a:focus-visible::after,
  a[aria-current='page']::after {
    transform: scaleX(1);
  }

  a[aria-current='page'] {
    font-weight: 650;
  }

  .site-navigation__external {
    color: var(--frasto-ink-muted);
  }

  @media (max-width: 62rem) {
    .site-navigation__npm {
      display: none;
    }
  }

  @media (max-width: 49.999rem) {
    .site-navigation__external {
      display: none;
    }
  }

  @media (max-width: 34rem) {
    .site-navigation__primary a:first-child {
      display: none;
    }

    .site-navigation__primary {
      gap: 0.75rem;
    }

    .site-navigation {
      gap: 0.5rem;
    }
  }

</style>
