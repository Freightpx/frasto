---
import frastroLogoBlack from '../../../../logo/frastro_logo_black_nobg.png?url';
import frastroLogoWhite from '../../../../logo/frastro_logo_white_nobg.png?url';

interface Props {
  class?: string;
  size?: 'sm' | 'md';
  suffix?: string;
}

const {
  class: className,
  size = 'md',
  suffix = 'UI',
} = Astro.props;
---

<span class:list={['brand-lockup', className]} data-size={size}>
  <span class="brand-mark" aria-hidden="true">
    <img class="brand-mark__logo brand-mark__logo--light" src={frastroLogoBlack} width="32" height="32" alt="" loading="eager" />
    <img class="brand-mark__logo brand-mark__logo--dark" src={frastroLogoWhite} width="32" height="32" alt="" loading="eager" />
  </span>
  <span class="brand-name">Frasto</span>
  {suffix && <span class="brand-suffix">{suffix}</span>}
</span>

<style>
  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    font-family: var(--frasto-font-display, "Inter Tight", Inter, sans-serif);
    color: var(--site-ink, var(--frasto-ink, #111));
    line-height: 1;
    white-space: nowrap;
  }

  .brand-mark {
    position: relative;
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
  }

  .brand-mark__logo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand-mark__logo--dark {
    display: none;
  }

  :global([data-theme='dark']) .brand-mark__logo--light {
    display: none;
  }

  :global([data-theme='dark']) .brand-mark__logo--dark {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .brand-mark__logo--light {
      display: none;
    }

    :global(html:not([data-theme])) .brand-mark__logo--dark {
      display: block;
    }
  }

  .brand-name {
    font-weight: 750;
    letter-spacing: -0.04em;
  }

  .brand-suffix {
    color: var(--site-muted, var(--frasto-ink-muted, #66645f));
    font-family: var(--frasto-font-sans, Inter, sans-serif);
    font-size: 0.625rem;
    font-weight: 650;
    letter-spacing: 0.1em;
  }

  [data-size='sm'] {
    gap: 0.3rem;
    font-size: 0.875rem;
  }

  [data-size='sm'] .brand-mark {
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
