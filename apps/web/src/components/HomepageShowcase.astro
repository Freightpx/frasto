---
import {
  Accordion,
  AccordionContent,
  AccordionItem,
  AccordionTrigger,
  Alert,
  Avatar,
  Badge,
  Breadcrumb,
  BreadcrumbItem,
  Button,
  ButtonGroup,
  ButtonGroupSeparator,
  Checkbox,
  CircleCheckIcon,
  Collapsible,
  CollapsibleContent,
  CollapsibleTrigger,
  Dialog,
  Drawer,
  Dropdown,
  DropdownItem,
  EmptyState,
  FileTextIcon,
  FormDescription,
  FormField,
  FormLabel,
  Icon,
  IconButton,
  InfoIcon,
  Input,
  MenuIcon,
  PageHeader,
  Pagination,
  PaginationItem,
  PlusIcon,
  Popover,
  Radio,
  SearchInput,
  Select,
  Separator,
  Skeleton,
  Spinner,
  Stat,
  Status,
  Surface,
  Switch,
  Tab,
  Table,
  TabPanel,
  Tabs,
  Textarea,
  ThemeSwitch,
  ToastRegion,
  Tooltip,
} from '@freight-px/frasto';
import avatar01 from '../../../../avatars/frasto_avatar-01.svg';
---

<section class="component-field" id="components" aria-labelledby="component-field-title" data-homepage-showcase>
  <header class="component-field__heading">
    <p>35 EXPERIMENTAL FAMILIES</p>
    <div>
      <h2 id="component-field-title">Every family, at a glance.</h2>
      <p>A compact catalogue of the public inventory, rendered directly with the package.</p>
    </div>
  </header>

  <div class="component-field__grid">
    <section class="showcase-region showcase-region--compose" aria-labelledby="showcase-compose">
      <header class="showcase-region__header">
        <span>01</span><h3 id="showcase-compose">Compose</h3><small>10 families</small>
      </header>
      <div class="showcase-region__body showcase-compose">
        <div class="specimen specimen--wide">
          <span class="specimen__name">Page header</span>
          <div class="specimen__demo">
            <PageHeader
              title="Release workspace"
              eyebrow="FRST-021"
              headingLevel={4}
            >
              <span slot="metadata">35 families · Astro 7</span>
            </PageHeader>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Breadcrumb</span>
          <div class="specimen__demo">
            <Breadcrumb label="Release workspace path">
              <BreadcrumbItem href="#components">Frasto</BreadcrumbItem>
              <BreadcrumbItem current>Release</BreadcrumbItem>
            </Breadcrumb>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Button</span>
          <div class="specimen__demo specimen__demo--row">
            <Button size="sm">Review</Button>
            <Button size="sm" variant="outline">Save draft</Button>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Icon button</span>
          <div class="specimen__demo specimen__demo--row">
            <IconButton icon={PlusIcon} label="Add component" size="sm" />
            <IconButton icon={MenuIcon} label="More actions" size="sm" variant="outline" />
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Button group</span>
          <div class="specimen__demo">
            <ButtonGroup label="Release actions">
              <Button size="sm">Ship</Button>
              <ButtonGroupSeparator />
              <IconButton icon={MenuIcon} label="More release actions" size="sm" />
            </ButtonGroup>
          </div>
        </div>
        <div class="specimen specimen--wide">
          <span class="specimen__name">Form field</span>
          <div class="specimen__demo">
            <FormField>
              <FormLabel for="showcase-project" required>Project name</FormLabel>
              <FormDescription id="showcase-project-help">Shown in the release summary.</FormDescription>
              <Input id="showcase-project" name="project" value="Frasto UI" aria-describedby="showcase-project-help" />
            </FormField>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Input</span>
          <div class="specimen__demo">
            <Input name="component" placeholder="search-component" aria-label="Component name" />
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Select</span>
          <div class="specimen__demo">
            <Select name="channel" aria-label="Release channel">
              <option>Public alpha</option>
              <option>Internal preview</option>
            </Select>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Textarea</span>
          <div class="specimen__demo">
            <Textarea name="summary" rows={2} aria-label="Release summary">Overlay hardening.</Textarea>
          </div>
        </div>
        <div class="specimen specimen--wide">
          <span class="specimen__name">Search input</span>
          <div class="specimen__demo">
            <SearchInput
              id="showcase-search"
              name="component"
              label="Search component families"
              placeholder="Search the public inventory…"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="showcase-region showcase-region--choose" aria-labelledby="showcase-choose">
      <header class="showcase-region__header">
        <span>02</span><h3 id="showcase-choose">Choose</h3><small>4 families</small>
      </header>
      <div class="showcase-region__body showcase-choices">
        <div class="specimen">
          <span class="specimen__name">Checkbox</span>
          <div class="specimen__demo specimen__demo--stack">
            <Checkbox name="checks" value="browser" checked>Browser matrix</Checkbox>
            <Checkbox name="checks" value="device">Physical device</Checkbox>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Radio</span>
          <div class="specimen__demo specimen__demo--row">
            <Radio name="release-channel" value="next" checked>next</Radio>
            <Radio name="release-channel" value="latest">latest</Radio>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Switch</span>
          <div class="specimen__demo">
            <Switch name="release-notes" checked>Include release notes</Switch>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Theme switch</span>
          <div class="specimen__demo">
            <ThemeSwitch variant="segmented-icons" storageKey="starlight-theme" label="Showcase color theme" />
          </div>
        </div>
      </div>
    </section>

    <section class="showcase-region showcase-region--load" aria-labelledby="showcase-load">
      <header class="showcase-region__header">
        <span>03</span><h3 id="showcase-load">Load</h3><small>2 families</small>
      </header>
      <div class="showcase-region__body showcase-loading" aria-label="Loading component examples">
        <div class="specimen">
          <span class="specimen__name">Spinner</span>
          <div class="specimen__demo specimen__demo--row">
            <Spinner label="Checking package" />
            <span class="specimen__hint">Checking package</span>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Skeleton</span>
          <div class="specimen__demo specimen__demo--stack" aria-busy="true">
            <Skeleton style="width:64%;" />
            <Skeleton style="width:88%;" />
          </div>
        </div>
      </div>
    </section>

    <section class="showcase-region showcase-region--reveal" aria-labelledby="showcase-reveal">
      <header class="showcase-region__header">
        <span>04</span><h3 id="showcase-reveal">Reveal</h3><small>5 families</small>
      </header>
      <div class="showcase-region__body showcase-overlays">
        <div class="specimen">
          <span class="specimen__name">Dropdown</span>
          <div class="specimen__demo">
            <Dropdown label="Release menu" placement="bottom-start">
              <Button slot="trigger" size="sm" variant="outline">Actions</Button>
              <DropdownItem>Review changes</DropdownItem>
              <DropdownItem>Copy release notes</DropdownItem>
              <DropdownItem disabled>Publish stable</DropdownItem>
            </Dropdown>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Popover</span>
          <div class="specimen__demo">
            <Popover label="Package status" placement="bottom-start">
              <Button slot="trigger" size="sm" variant="outline">Details</Button>
              <strong>Tarball verified</strong>
              <p>The packed consumer compiled every family.</p>
            </Popover>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Tooltip</span>
          <div class="specimen__demo">
            <Tooltip content="All exports are flat package imports" placement="top">
              <IconButton icon={InfoIcon} label="Explain package exports" size="sm" variant="outline" />
            </Tooltip>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Dialog</span>
          <div class="specimen__demo">
            <Dialog title="Review release" description="Confirm the evidence attached to this alpha release." size="sm">
              <Button slot="trigger" size="sm" variant="outline">Open dialog</Button>
              <p class="showcase-overlay-copy">Automated checks passed.</p>
              <Button slot="footer" size="sm" variant="outline" data-frasto-dialog-close>Close</Button>
            </Dialog>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Drawer</span>
          <div class="specimen__demo">
            <Drawer title="Release details" description="A wider view of the current alpha evidence." size="sm">
              <Button slot="trigger" size="sm" variant="outline">Open drawer</Button>
              <dl class="showcase-detail-list">
                <div><dt>Version</dt><dd>0.1.0-alpha.1</dd></div>
                <div><dt>Families</dt><dd>35 Experimental</dd></div>
              </dl>
            </Drawer>
          </div>
        </div>
      </div>
    </section>

    <section class="showcase-region showcase-region--communicate" aria-labelledby="showcase-communicate">
      <header class="showcase-region__header">
        <span>05</span><h3 id="showcase-communicate">Communicate</h3><small>7 families</small>
      </header>
      <div class="showcase-region__body showcase-feedback">
        <div class="specimen">
          <span class="specimen__name">Alert</span>
          <div class="specimen__demo">
            <Alert title="Quality gate passed" tone="positive">
              <CircleCheckIcon slot="icon" size={20} stroke-width={1.25} aria-hidden="true" />
              Package and browser evidence are current.
              <Button slot="action" size="sm" variant="outline" data-home-toast>Notify</Button>
            </Alert>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Badge · Status · Avatar</span>
          <div class="specimen__demo specimen__demo--row">
            <Badge tone="info">Experimental</Badge>
            <Status tone="positive">All systems ready</Status>
            <Avatar size="md" src={avatar01} alt="" imageClass="frasto-avatar-artwork" />
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Stat</span>
          <div class="specimen__demo">
            <Stat label="Public families" value="35" change="+2 this cycle" changeTone="positive" />
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Empty state</span>
          <div class="specimen__demo">
            <EmptyState
              title="No critical issues"
              description="New reports will appear here after triage."
              headingLevel={4}
            >
              <Icon slot="icon" icon={FileTextIcon} size={20} />
            </EmptyState>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Toast</span>
          <div class="specimen__demo">
            <ToastRegion label="Homepage notifications" />
            <span class="specimen__hint">Triggered by the alert action.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="showcase-region showcase-region--navigate" aria-labelledby="showcase-navigate">
      <header class="showcase-region__header">
        <span>06</span><h3 id="showcase-navigate">Navigate</h3><small>4 families</small>
      </header>
      <div class="showcase-region__body showcase-navigation">
        <div class="specimen">
          <span class="specimen__name">Tabs</span>
          <div class="specimen__demo">
            <Tabs label="Release evidence" defaultValue="automated" variant="segmented">
              <Tab slot="tab" value="automated">Automated</Tab>
              <Tab slot="tab" value="manual">Manual review</Tab>
              <TabPanel slot="panel" value="automated"><p>Chromium, Firefox, WebKit, and the packed consumer are passing.</p></TabPanel>
              <TabPanel slot="panel" value="manual"><p>Keyboard and assistive-technology notes stay attached to the release.</p></TabPanel>
            </Tabs>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Accordion</span>
          <div class="specimen__demo">
            <Accordion defaultValue="package" collapsible>
              <AccordionItem value="package">
                <AccordionTrigger>What ships in the package?</AccordionTrigger>
                <AccordionContent>Astro components, exported types, tokens, and the compiled stylesheet.</AccordionContent>
              </AccordionItem>
            </Accordion>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Collapsible</span>
          <div class="specimen__demo">
            <Collapsible>
              <CollapsibleTrigger>Show compatibility details</CollapsibleTrigger>
              <CollapsibleContent>Astro 7 and Node.js 22 or newer.</CollapsibleContent>
            </Collapsible>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Pagination</span>
          <div class="specimen__demo">
            <Pagination label="Component showcase pages">
              <span slot="summary">Page 1 of 2</span>
              <PaginationItem kind="previous" disabled>Previous</PaginationItem>
              <PaginationItem current label="Current page, page 1">1</PaginationItem>
              <PaginationItem href="#showcase-communicate" label="Go to page 2">2</PaginationItem>
              <PaginationItem kind="next" href="#showcase-communicate">Next</PaginationItem>
            </Pagination>
          </div>
        </div>
      </div>
    </section>

    <section class="showcase-region showcase-region--structure" aria-labelledby="showcase-structure">
      <header class="showcase-region__header">
        <span>07</span><h3 id="showcase-structure">Structure and data</h3><small>3 families</small>
      </header>
      <div class="showcase-region__body showcase-structure">
        <div class="specimen">
          <span class="specimen__name">Table</span>
          <div class="specimen__demo showcase-table-wrap">
            <Table caption="Latest verification runs" captionHidden minWidth="0" density="compact">
              <thead><tr><th scope="col">Check</th><th scope="col">Environment</th><th scope="col">Result</th></tr></thead>
              <tbody>
                <tr><th scope="row">Browser matrix</th><td>3 engines</td><td><Status tone="positive">Passed</Status></td></tr>
              </tbody>
            </Table>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Surface</span>
          <div class="specimen__demo">
            <Surface as="article" variant="outlined" padding="sm">
              <strong>Verification runs</strong>
              <span class="specimen__hint">Latest package evidence</span>
            </Surface>
          </div>
        </div>
        <div class="specimen">
          <span class="specimen__name">Separator</span>
          <div class="specimen__demo specimen__demo--stack">
            <span class="specimen__hint">Above the rule</span>
            <Separator />
            <span class="specimen__hint">Below the rule</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</section>

<script>
  import { toast } from '@freight-px/frasto';

  document.querySelector<HTMLElement>('[data-home-toast]')?.addEventListener('click', () => {
    toast({
      title: 'Release team notified',
      description: 'The quality-gate summary is ready for review.',
      tone: 'positive',
    });
  });
</script>

<style>
  .component-field {
    padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 4vw, 4rem);
    border-bottom: 1px solid var(--frasto-border);
  }

  .component-field__heading {
    display: grid;
    grid-template-columns: minmax(10rem, 0.4fr) minmax(0, 1.6fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .component-field__heading > p,
  .showcase-region__header span,
  .showcase-region__header small {
    margin: 0;
    color: var(--frasto-ink-muted);
    font-size: 0.65625rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .component-field__heading h2 {
    max-width: 18ch;
    margin: 0;
    font-family: var(--frasto-font-display);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .component-field__heading div > p {
    max-width: 36rem;
    margin: 0.75rem 0 0;
    color: var(--frasto-ink-muted);
    line-height: 1.55;
  }

  .component-field__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    border-top: 1px solid var(--frasto-border);
    border-left: 1px solid var(--frasto-border);
  }

  .showcase-region {
    min-width: 0;
    border-right: 1px solid var(--frasto-border);
    border-bottom: 1px solid var(--frasto-border);
    background: var(--frasto-surface);
  }

  .showcase-region--compose {
    grid-column: span 12;
  }

  .showcase-region--choose,
  .showcase-region--load,
  .showcase-region--reveal {
    grid-column: span 4;
  }

  .showcase-region--communicate,
  .showcase-region--navigate,
  .showcase-region--structure {
    grid-column: span 4;
  }

  .showcase-region__header {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: baseline;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--frasto-border);
  }

  .showcase-region__header span::after {
    content: "/";
    margin-inline-start: 0.5rem;
    color: var(--frasto-ink-muted);
    font-weight: 400;
  }

  .showcase-region__header h3 {
    margin: 0;
    font-family: var(--frasto-font-display);
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .showcase-region__header small {
    justify-self: end;
    text-align: end;
  }

  .showcase-region__body {
    display: grid;
    min-width: 0;
    gap: 1px;
    background: var(--frasto-border);
  }

  .specimen {
    min-width: 0;
    padding: 0.75rem 0.875rem;
    background: var(--frasto-surface);
  }

  .specimen__name {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--frasto-ink-muted);
    font-size: 0.625rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .specimen__demo {
    min-width: 0;
  }

  .specimen__demo--row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .specimen__demo--stack {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .specimen__hint {
    color: var(--frasto-ink-muted);
    font-size: 0.75rem;
  }

  .showcase-compose {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .showcase-compose .specimen--wide {
    grid-column: span 2;
  }

  .showcase-choices,
  .showcase-loading,
  .showcase-feedback,
  .showcase-navigation,
  .showcase-structure {
    grid-template-columns: 1fr;
  }

  .showcase-overlays {
    grid-template-columns: 1fr;
  }

  .showcase-navigation :global([data-frasto-tab-panel]) p,
  .showcase-overlay-copy,
  .showcase-overlays :global([data-frasto-popover-panel]) p {
    margin: 0;
    color: var(--frasto-ink-muted);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .showcase-detail-list {
    margin: 0;
  }

  .showcase-detail-list div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--frasto-border);
  }

  .showcase-detail-list div:last-child {
    border-bottom: 0;
  }

  .showcase-detail-list dt {
    color: var(--frasto-ink-muted);
    font-size: 0.75rem;
  }

  .showcase-detail-list dd {
    margin: 0;
    font-size: 0.8125rem;
  }

  .showcase-table-wrap {
    max-width: 100%;
    overflow-x: auto;
  }

  @media (max-width: 68rem) {
    .showcase-region--choose,
    .showcase-region--load,
    .showcase-region--reveal,
    .showcase-region--communicate,
    .showcase-region--navigate,
    .showcase-region--structure {
      grid-column: span 6;
    }

    .showcase-compose {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .component-field__heading {
      grid-template-columns: 1fr;
    }

    .showcase-region--choose,
    .showcase-region--load,
    .showcase-region--reveal,
    .showcase-region--communicate,
    .showcase-region--navigate,
    .showcase-region--structure {
      grid-column: span 12;
    }

    .showcase-compose {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .component-field {
      padding-inline: 0;
    }

    .component-field__heading {
      padding-inline: 1rem;
    }

    .component-field__grid {
      border-left: 0;
    }

    .showcase-region {
      border-right: 0;
    }

    .showcase-compose {
      grid-template-columns: 1fr;
    }

    .showcase-compose .specimen--wide {
      grid-column: auto;
    }

    .showcase-region__header small {
      display: none;
    }
  }
</style>
