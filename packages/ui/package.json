{
  "name": "@freightpx/frasto",
  "version": "0.0.0",
  "type": "module",
  "description": "Astro-first SaaS UI design system by Freightpx.",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "peerDependencies": {
    "astro": ">=7.0.0"
  },
  "scripts": {
    "build:styles": "tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --minify",
    "build": "pnpm build:styles && astro check --root .",
    "check": "pnpm build:styles && astro check --root .",
    "dev": "tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --watch",
    "prepack": "pnpm build:styles"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/cli": "4.3.3",
    "astro": "7.2.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@lucide/astro": "1.34.0"
  }
}
