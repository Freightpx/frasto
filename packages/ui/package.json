{
  "name": "@freight-px/frasto",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "description": "Astro-first open-source UI component library and design system by Freightpx.",
  "keywords": [
    "astro",
    "components",
    "design-system",
    "ui",
    "accessibility"
  ],
  "homepage": "https://frasto.freightpx.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Freightpx/frasto.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Freightpx/frasto/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "sideEffects": [
    "./src/index.ts",
    "**/*.css"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "src",
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "peerDependencies": {
    "astro": ">=7.0.0 <8.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:styles": "tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --minify",
    "build": "pnpm build:styles && astro check --root .",
    "check": "pnpm build:styles && astro check --root .",
    "dev": "tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --watch",
    "prepack": "pnpm build:styles"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/cli": "4.3.3",
    "astro": "7.2.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@lucide/astro": "1.39.0"
  }
}
