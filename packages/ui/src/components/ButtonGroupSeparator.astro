---
import type { HTMLAttributes } from 'astro/types';
import { buttonGroupSeparator } from './button-group-styles';

type Props = Omit<HTMLAttributes<'span'>, 'aria-hidden' | 'class'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<span {...rest} class:list={[buttonGroupSeparator, className]} aria-hidden="true" data-frasto-button-group-separator></span>
