---
import type { AstroComponent, IconProps as LucideIconProps } from '@lucide/astro';

interface Props extends Omit<LucideIconProps, 'stroke-width'> {
  icon: AstroComponent;
  label?: string;
  strokeWidth?: number | string;
}

const {
  icon: Glyph,
  label,
  size = 16,
  strokeWidth = 1.25,
  class: className,
  ...rest
} = Astro.props;
---

<Glyph
  {...rest}
  size={size}
  stroke-width={strokeWidth}
  class:list={['inline-block shrink-0 align-middle', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
/>
