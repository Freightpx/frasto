---
import type { HTMLAttributes } from 'astro/types';
import { buttonGroupText } from './button-group-styles';

type Props = Omit<HTMLAttributes<'span'>, 'class'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<span {...rest} class:list={[buttonGroupText, className]} data-frasto-button-group-text><slot /></span>
