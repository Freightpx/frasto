---
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import {
  avatarBase,
  avatarSizes,
  type AvatarSize,
} from './avatar-styles';

type Props = Omit<HTMLAttributes<'span'>, 'class'> & {
  alt?: string;
  class?: string;
  decoding?: 'async' | 'auto' | 'sync';
  fallback?: string;
  imageClass?: string;
  label?: string;
  loading?: 'eager' | 'lazy';
  size?: AvatarSize;
  src?: ImageMetadata | string;
};

const {
  alt = '',
  class: className,
  decoding = 'async',
  fallback = '?',
  imageClass,
  label,
  loading = 'lazy',
  size = 'md',
  src,
  ...rest
} = Astro.props;

const resolvedSrc = typeof src === 'string' ? src : src?.src;
const fallbackLabel = label ?? (alt || undefined);
---

<span
  {...rest}
  class:list={[avatarBase, avatarSizes[size], className]}
  role={!resolvedSrc && fallbackLabel ? 'img' : undefined}
  aria-label={!resolvedSrc ? fallbackLabel : undefined}
  data-frasto-avatar
  data-size={size}
  data-variant={resolvedSrc ? 'image' : 'fallback'}
>
  {resolvedSrc ? (
    <img
      src={resolvedSrc}
      alt={alt}
      loading={loading}
      decoding={decoding}
      class:list={['size-full object-cover', imageClass]}
      data-frasto-avatar-image
    />
  ) : (
    <span aria-hidden={fallbackLabel ? 'true' : undefined} data-frasto-avatar-fallback>
      <slot name="fallback">{fallback}</slot>
    </span>
  )}
</span>
