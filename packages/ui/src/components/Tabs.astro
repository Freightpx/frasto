---
import type { HTMLAttributes } from 'astro/types';
import {
  tabIndicator,
  tabListBase,
  tabListVariants,
  tabsRoot,
  type TabsVariant,
} from './tabs-styles';

type Props = Omit<HTMLAttributes<'div'>, 'class' | 'role'> & {
  class?: string;
  defaultValue?: string;
  label: string;
  listClass?: string;
  variant?: TabsVariant;
};

const {
  class: className,
  defaultValue,
  label,
  listClass,
  variant = 'underline',
  ...rest
} = Astro.props;
---

<frasto-tabs
  {...rest}
  class:list={[tabsRoot, className]}
  data-default-value={defaultValue}
  data-frasto-tabs
  data-variant={variant}
>
  <div
    class:list={[tabListBase, tabListVariants[variant], listClass]}
    role="tablist"
    aria-label={label}
    data-frasto-tab-list
    data-variant={variant}
  >
    {variant === 'segmented' && <span class:list={tabIndicator} aria-hidden="true" data-frasto-tab-indicator></span>}
    <slot name="tab" />
  </div>
  <div data-frasto-tab-panels>
    <slot name="panel" />
  </div>
</frasto-tabs>

<script>
  let tabsInstance = 0;

  class FrastoTabs extends HTMLElement {
    private panels: HTMLElement[] = [];
    private tabs: HTMLButtonElement[] = [];
    private tabList: HTMLElement | null = null;
    private indicator: HTMLElement | null = null;
    private resizeObserver: ResizeObserver | null = null;
    private mutationObserver: MutationObserver | null = null;
    private layoutFrame: number | null = null;
    private pendingInitialLayout = false;
    private measuring = false;

    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';
      tabsInstance += 1;
      this.tabs = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-frasto-tab]'));
      this.panels = Array.from(this.querySelectorAll<HTMLElement>('[data-frasto-tab-panel]'));
      this.tabList = this.querySelector<HTMLElement>('[data-frasto-tab-list]');
      this.indicator = this.querySelector<HTMLElement>('[data-frasto-tab-indicator]');

      this.tabs.forEach((tab, index) => {
        const panel = this.panels.find((candidate) => candidate.dataset.value === tab.dataset.value);
        tab.id ||= `frasto-tab-${tabsInstance}-${index}`;
        if (panel) {
          panel.id ||= `frasto-tab-panel-${tabsInstance}-${index}`;
          tab.setAttribute('aria-controls', panel.id);
          panel.setAttribute('aria-labelledby', tab.id);
        }
        tab.addEventListener('click', this.handleClick);
        tab.addEventListener('keydown', this.handleKeydown);
      });

      const selected = this.tabs.find((tab) => tab.dataset.value === this.dataset.defaultValue && !tab.disabled)
        ?? this.tabs.find((tab) => !tab.disabled);
      if (selected) this.activate(selected, false, false);
      this.setupLayout();
    }

    disconnectedCallback() {
      this.tabs.forEach((tab) => {
        tab.removeEventListener('click', this.handleClick);
        tab.removeEventListener('keydown', this.handleKeydown);
      });
      this.tabList?.removeEventListener('scroll', this.handleScroll);
      this.resizeObserver?.disconnect();
      this.resizeObserver = null;
      this.mutationObserver?.disconnect();
      this.mutationObserver = null;
      if (this.layoutFrame !== null) cancelAnimationFrame(this.layoutFrame);
      this.layoutFrame = null;
      delete this.dataset.initialized;
    }

    private handleClick = (event: Event) => this.activate(event.currentTarget as HTMLButtonElement);
    private handleKeydown = (event: KeyboardEvent) => {
      const enabled = this.tabs.filter((tab) => !tab.disabled);
      const current = enabled.indexOf(event.currentTarget as HTMLButtonElement);
      let next = current;
      if (event.key === 'ArrowRight') next = (current + 1) % enabled.length;
      else if (event.key === 'ArrowLeft') next = (current - 1 + enabled.length) % enabled.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = enabled.length - 1;
      else return;
      event.preventDefault();
      if (enabled[next]) this.activate(enabled[next], true);
    };

    private activate(tab: HTMLButtonElement, focus = false, emit = true) {
      if (tab.disabled) return;
      const value = tab.dataset.value;
      this.tabs.forEach((candidate) => {
        const selected = candidate === tab;
        candidate.setAttribute('aria-selected', selected ? 'true' : 'false');
        candidate.tabIndex = selected ? 0 : -1;
      });
      this.panels.forEach((panel) => {
        panel.hidden = panel.dataset.value !== value;
      });
      if (focus) tab.focus();
      this.updateIndicator(tab);
      if (emit) {
        this.dispatchEvent(new CustomEvent('frasto:tab-change', {
          bubbles: true,
          detail: { value },
        }));
      }
    }

    private handleScroll = () => this.updateIndicator();

    private setupLayout() {
      this.resizeObserver = new ResizeObserver(() => this.scheduleLayout());
      this.resizeObserver.observe(this);
      this.tabs.forEach((tab) => this.resizeObserver?.observe(tab));
      this.mutationObserver = new MutationObserver(() => this.scheduleLayout());
      this.tabs.forEach((tab) => this.mutationObserver?.observe(tab, {
        characterData: true,
        childList: true,
        subtree: true,
      }));
      this.tabList?.addEventListener('scroll', this.handleScroll, { passive: true });
      document.fonts?.ready.then(() => this.scheduleLayout());
      this.scheduleLayout(true);
    }

    private scheduleLayout(initial = false) {
      this.pendingInitialLayout ||= initial;
      if (this.layoutFrame !== null) return;
      this.layoutFrame = requestAnimationFrame(() => {
        this.layoutFrame = null;
        const initialLayout = this.pendingInitialLayout;
        this.pendingInitialLayout = false;
        this.reserveTabWidths();
        this.updateIndicator(undefined, initialLayout);
      });
    }

    private reserveTabWidths() {
      if (this.measuring) return;
      this.measuring = true;
      const selectedStates = this.tabs.map((tab) => tab.getAttribute('aria-selected') === 'true');
      this.tabs.forEach((tab) => tab.style.removeProperty('--frasto-tab-reserved-width'));

      this.tabs.forEach((tab, index) => {
        tab.setAttribute('aria-selected', 'false');
        const normalWidth = tab.getBoundingClientRect().width;
        tab.setAttribute('aria-selected', 'true');
        const selectedWidth = tab.getBoundingClientRect().width;
        tab.setAttribute('aria-selected', selectedStates[index] ? 'true' : 'false');
        const reservedWidth = Math.ceil(Math.max(normalWidth, selectedWidth));
        tab.style.setProperty('--frasto-tab-reserved-width', String(reservedWidth) + 'px');
      });
      this.measuring = false;
    }

    private updateIndicator(tab?: HTMLButtonElement, initial = false) {
      if (!this.indicator || this.dataset.variant !== 'segmented') return;
      const selected = tab ?? this.tabs.find((candidate) => candidate.getAttribute('aria-selected') === 'true');
      if (!selected) return;
      if (initial) delete this.dataset.indicatorReady;
      this.style.setProperty('--frasto-tabs-indicator-x', `${selected.offsetLeft}px`);
      this.style.setProperty('--frasto-tabs-indicator-width', `${selected.offsetWidth}px`);
      requestAnimationFrame(() => {
        this.dataset.indicatorReady = 'true';
      });
    }
  }

  if (!customElements.get('frasto-tabs')) {
    customElements.define('frasto-tabs', FrastoTabs);
  }
</script>
