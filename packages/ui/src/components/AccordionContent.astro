---
import type { HTMLAttributes } from 'astro/types';
import { accordionContent } from './accordion-styles';

type Props = Omit<HTMLAttributes<'div'>, 'class'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<div {...rest} class:list={[accordionContent, className]} data-frasto-accordion-content><slot /></div>
