---
import { X } from '@lucide/astro';
import type { HTMLAttributes } from 'astro/types';
import IconButton from './IconButton.astro';
import {
  drawerElement,
  drawerPanel,
  drawerRoot,
  drawerSides,
  drawerSizes,
  type DrawerSide,
  type DrawerSize,
} from './drawer-styles';

type Props = Omit<HTMLAttributes<'dialog'>, 'class' | 'open'> & {
  class?: string;
  closeLabel?: string;
  description?: string;
  dialogClass?: string;
  dismissible?: boolean;
  panelClass?: string;
  side?: DrawerSide;
  size?: DrawerSize;
  title: string;
};

const {
  class: className,
  closeLabel = 'Close drawer',
  description,
  dialogClass,
  dismissible = true,
  id,
  panelClass,
  side = 'right',
  size = 'md',
  title,
  ...rest
} = Astro.props;

const drawerId = id ?? `frasto-drawer-${Math.random().toString(36).slice(2)}`;
const titleId = `${drawerId}-title`;
const descriptionId = description ? `${drawerId}-description` : undefined;
---

<frasto-drawer class:list={[drawerRoot, className]} data-dismissible={dismissible ? 'true' : 'false'}>
  <span class="inline-flex" data-frasto-overlay-trigger><slot name="trigger" /></span>
  <dialog
    {...rest}
    id={drawerId}
    class:list={[drawerElement, dialogClass]}
    aria-labelledby={titleId}
    aria-describedby={descriptionId}
    data-frasto-drawer
    data-side={side}
  >
    <div class:list={[drawerPanel, drawerSides[side], drawerSizes[size], panelClass]} data-frasto-drawer-panel>
      <header class="flex items-start justify-between gap-4 border-b border-[var(--frasto-border)] p-6">
        <div class="min-w-0">
          <h2 id={titleId} class="m-0 font-medium text-lg leading-6">{title}</h2>
          {description && <p id={descriptionId} class="m-0 mt-2 text-sm leading-5 text-[var(--frasto-ink-muted)]">{description}</p>}
        </div>
        <IconButton icon={X} label={closeLabel} size="sm" data-frasto-drawer-close />
      </header>
      <div class="min-h-0 flex-1 overflow-y-auto p-6" data-frasto-drawer-content><slot /></div>
      {Astro.slots.has('footer') && (
        <footer class="flex flex-wrap items-center justify-end gap-2 border-t border-[var(--frasto-border)] p-6">
          <slot name="footer" />
        </footer>
      )}
    </div>
  </dialog>
</frasto-drawer>

<script>
  import { lockDocumentScroll, unlockDocumentScroll } from './overlay-scroll-lock';

  class FrastoDrawer extends HTMLElement {
    private dialog: HTMLDialogElement | null = null;
    private opener: HTMLElement | null = null;
    private scrollLocked = false;
    private trigger: HTMLElement | null = null;
    private closeTimer: number | null = null;

    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';
      const triggerRoot = this.querySelector<HTMLElement>('[data-frasto-overlay-trigger]');
      this.trigger = triggerRoot?.querySelector<HTMLElement>('button, a, [tabindex]') ?? null;
      this.dialog = this.querySelector('dialog[data-frasto-drawer]');
      if (!this.trigger || !this.dialog) return;
      this.trigger.setAttribute('aria-haspopup', 'dialog');
      this.trigger.setAttribute('aria-controls', this.dialog.id);
      this.trigger.setAttribute('aria-expanded', 'false');
      this.trigger.addEventListener('click', this.open);
      this.dialog.addEventListener('cancel', this.handleCancel);
      this.dialog.addEventListener('close', this.handleClose);
      this.dialog.addEventListener('pointerdown', this.handleBackdropPointer);
      this.querySelectorAll('[data-frasto-drawer-close]').forEach((button) => button.addEventListener('click', this.requestClose));
    }

    disconnectedCallback() {
      this.trigger?.removeEventListener('click', this.open);
      this.dialog?.removeEventListener('cancel', this.handleCancel);
      this.dialog?.removeEventListener('close', this.handleClose);
      this.dialog?.removeEventListener('pointerdown', this.handleBackdropPointer);
      this.querySelectorAll('[data-frasto-drawer-close]').forEach((button) => button.removeEventListener('click', this.requestClose));
      if (this.closeTimer !== null) window.clearTimeout(this.closeTimer);
      this.releaseScrollLock();
      delete this.dataset.initialized;
    }

    private open = () => {
      if (!this.dialog || this.dialog.open) return;
      this.opener = this.trigger;
      this.dialog.dataset.state = 'opening';
      this.dialog.showModal();
      this.dialog.getBoundingClientRect();
      requestAnimationFrame(() => {
        if (this.dialog?.open) this.dialog.dataset.state = 'open';
      });
      lockDocumentScroll();
      this.scrollLocked = true;
      this.trigger?.setAttribute('aria-expanded', 'true');
      this.dispatchEvent(new CustomEvent('frasto:open', { bubbles: true }));
    };

    private requestClose = () => {
      if (!this.dialog?.open || this.dialog.dataset.state === 'closing') return;
      this.dialog.dataset.state = 'closing';
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        this.dialog.close();
        return;
      }

      let finished = false;
      const finish = () => {
        if (finished) return;
        finished = true;
        if (this.closeTimer !== null) window.clearTimeout(this.closeTimer);
        this.closeTimer = null;
        if (this.dialog?.open) this.dialog.close();
      };
      const panel = this.dialog.querySelector<HTMLElement>('[data-frasto-drawer-panel]');
      panel?.addEventListener('transitionend', (event) => {
        if (event.propertyName === 'transform') finish();
      }, { once: true });
      this.closeTimer = window.setTimeout(finish, 240);
    };

    private handleCancel = (event: Event) => {
      event.preventDefault();
      if (this.dataset.dismissible === 'true') this.requestClose();
    };
    private handleBackdropPointer = (event: PointerEvent) => {
      if (this.dataset.dismissible === 'true' && event.target === this.dialog) this.requestClose();
    };
    private handleClose = () => {
      if (this.closeTimer !== null) window.clearTimeout(this.closeTimer);
      this.closeTimer = null;
      if (this.dialog) delete this.dialog.dataset.state;
      this.releaseScrollLock();
      this.trigger?.setAttribute('aria-expanded', 'false');
      const opener = this.opener;
      requestAnimationFrame(() => {
        if (opener?.isConnected) opener.focus();
      });
      this.dispatchEvent(new CustomEvent('frasto:close', { bubbles: true }));
    };
    private releaseScrollLock = () => {
      if (!this.scrollLocked) return;
      unlockDocumentScroll();
      this.scrollLocked = false;
    };
  }

  if (!customElements.get('frasto-drawer')) {
    customElements.define('frasto-drawer', FrastoDrawer);
  }
</script>
