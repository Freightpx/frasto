---
import type { HTMLAttributes } from 'astro/types';
import {
  dropdownPanel,
  dropdownRoot,
  type DropdownPlacement,
} from './dropdown-styles';

type Props = Omit<HTMLAttributes<'div'>, 'class' | 'role'> & {
  class?: string;
  label: string;
  panelClass?: string;
  placement?: DropdownPlacement;
};

const {
  class: className,
  id,
  label,
  panelClass,
  placement = 'bottom-end',
  ...rest
} = Astro.props;

const panelId = id ?? `frasto-dropdown-${Math.random().toString(36).slice(2)}`;
---

<frasto-dropdown {...rest} class:list={[dropdownRoot, className]} data-frasto-dropdown data-placement={placement}>
  <span class="inline-flex" data-frasto-overlay-trigger><slot name="trigger" /></span>
  <div
    id={panelId}
    class:list={[dropdownPanel, panelClass]}
    role="menu"
    aria-label={label}
    data-frasto-dropdown-panel
    hidden
  >
    <slot />
  </div>
</frasto-dropdown>

<script>
  import { positionFloating } from './floating';
  import type { DropdownPlacement } from './dropdown-styles';

  class FrastoDropdown extends HTMLElement {
    private panel: HTMLElement | null = null;
    private trigger: HTMLElement | null = null;

    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';
      const triggerRoot = this.querySelector<HTMLElement>('[data-frasto-overlay-trigger]');
      this.trigger = triggerRoot?.querySelector<HTMLElement>('button, a, [tabindex]') ?? null;
      this.panel = this.querySelector('[data-frasto-dropdown-panel]');
      if (!this.trigger || !this.panel) return;

      this.trigger.setAttribute('aria-haspopup', 'menu');
      this.trigger.setAttribute('aria-controls', this.panel.id);
      this.trigger.setAttribute('aria-expanded', 'false');
      this.trigger.addEventListener('click', this.handleTriggerClick);
      this.trigger.addEventListener('keydown', this.handleTriggerKeydown);
      this.panel.addEventListener('keydown', this.handlePanelKeydown);
      this.panel.addEventListener('click', this.handlePanelClick);
      document.addEventListener('keydown', this.handleDocumentKeydown);
      document.addEventListener('pointerdown', this.handleOutsidePointer);
      window.addEventListener('resize', this.reposition);
      window.addEventListener('scroll', this.reposition, true);
    }

    disconnectedCallback() {
      this.trigger?.removeEventListener('click', this.handleTriggerClick);
      this.trigger?.removeEventListener('keydown', this.handleTriggerKeydown);
      this.panel?.removeEventListener('keydown', this.handlePanelKeydown);
      this.panel?.removeEventListener('click', this.handlePanelClick);
      document.removeEventListener('keydown', this.handleDocumentKeydown);
      document.removeEventListener('pointerdown', this.handleOutsidePointer);
      window.removeEventListener('resize', this.reposition);
      window.removeEventListener('scroll', this.reposition, true);
      delete this.dataset.initialized;
    }

    private items = () => Array.from(
      this.panel?.querySelectorAll<HTMLElement>('[role="menuitem"]:not([aria-disabled="true"]), button:not(:disabled), a[href]') ?? [],
    ).filter((item, index, all) => all.indexOf(item) === index);

    private handleTriggerClick = () => this.panel?.hidden ? this.open(false) : this.close();
    private handleTriggerKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape' && this.panel && !this.panel.hidden) {
        event.preventDefault();
        this.close();
        return;
      }
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      this.open(true, event.key === 'ArrowUp');
    };
    private handlePanelClick = (event: Event) => {
      const item = (event.target as Element).closest('[role="menuitem"], button, a');
      if (item && !item.hasAttribute('data-keep-open')) this.close(false);
    };
    private handleOutsidePointer = (event: PointerEvent) => {
      if (!this.contains(event.target as Node)) this.close(false);
    };
    private handleDocumentKeydown = (event: KeyboardEvent) => {
      if (event.key !== 'Escape' || !this.panel || this.panel.hidden) return;
      event.preventDefault();
      this.close();
    };
    private handlePanelKeydown = (event: KeyboardEvent) => {
      const items = this.items();
      const current = items.indexOf(document.activeElement as HTMLElement);
      let next = current;
      if (event.key === 'ArrowDown') next = (current + 1) % items.length;
      else if (event.key === 'ArrowUp') next = (current - 1 + items.length) % items.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = items.length - 1;
      else if (event.key === 'Escape') {
        event.preventDefault();
        this.close();
        return;
      } else if (event.key === 'Tab') {
        this.close(false);
        return;
      } else return;
      event.preventDefault();
      items[next]?.focus();
    };

    private open(focusItem = false, last = false) {
      if (!this.panel || !this.trigger || !this.panel.hidden) return;
      this.panel.hidden = false;
      this.trigger.setAttribute('aria-expanded', 'true');
      this.dataset.open = 'true';
      this.reposition();
      if (focusItem) {
        const items = this.items();
        items[last ? items.length - 1 : 0]?.focus();
      }
      this.dispatchEvent(new CustomEvent('frasto:open', { bubbles: true }));
    }

    private close(returnFocus = true) {
      if (!this.panel || !this.trigger || this.panel.hidden) return;
      this.panel.hidden = true;
      this.trigger.setAttribute('aria-expanded', 'false');
      delete this.dataset.open;
      if (returnFocus) this.trigger.focus();
      this.dispatchEvent(new CustomEvent('frasto:close', { bubbles: true }));
    }

    private reposition = () => {
      if (!this.panel || !this.trigger || this.panel.hidden) return;
      positionFloating(this.trigger, this.panel, (this.dataset.placement ?? 'bottom-end') as DropdownPlacement);
    };
  }

  if (!customElements.get('frasto-dropdown')) {
    customElements.define('frasto-dropdown', FrastoDropdown);
  }
</script>
